venv/
__pycache__/
*.pyc
.env
logs/
scripts/tradingbot.pids

# Local desktop instance's state -- not tracked, stays on this machine only.
storage/*.db
learn/current_strategy.json
learn/history.jsonl

# The cloud instance's state (storage/cloud_tradingbot.db, learn_cloud/,
# docs/data/) IS tracked -- GitHub Actions commits it back after every tick
# so state survives between ephemeral runner instances. See
# .github/workflows/paper_trade.yml.
!storage/cloud_tradingbot.db
