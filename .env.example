# Copy this file to .env and fill in your own values. Never commit .env.
#
# 1. Create a free OANDA account: https://www.oanda.com/forex-trading/demo-account/
# 2. In the OANDA account portal, generate a "Personal Access Token" (API key)
#    for the fxTrade Practice (demo) environment.
# 3. Find your practice account ID (looks like 101-004-XXXXXXX-001) in the
#    account portal under "My Account".

OANDA_API_KEY=your_practice_api_token_here
OANDA_ACCOUNT_ID=101-004-XXXXXXX-001
OANDA_ENV=practice

# Optional. A Discord "Webhook URL" from a channel's Integrations settings.
# Trade fills and re-tune switches get posted there. Leave unset to disable
# notifications entirely. Treat this as a secret -- anyone with it can post
# to that channel -- never commit the real value.
DISCORD_WEBHOOK_URL=
